# Kopiér til .env (lokalt) eller sæt som miljøvariabler hos din hosting.
# Din nøgle hentes fra https://console.anthropic.com  →  Settings → API Keys

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Valgfrit — port (mange hosts sætter selv PORT)
PORT=3000

# Valgfrit — overstyr modeller (standard er den hurtige/billige Haiku)
PARSE_MODEL=claude-haiku-4-5-20251001
WINE_MODEL=claude-haiku-4-5-20251001
